{
  "name": "eventhub-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "tsx --env-file-if-exists=.env --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:up": "docker compose --env-file .env up -d",
    "experiment:explain": "tsx --env-file-if-exists=.env experiments/explain-events.ts",
    "jobs:worker": "tsx --env-file-if-exists=.env src/jobs/worker-main.ts",
    "jobs:enqueue": "tsx --env-file-if-exists=.env src/jobs/enqueue-main.ts",
    "experiment:cache": "tsx --env-file-if-exists=.env experiments/cache-latency.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild": false
  },
  "dependencies": {
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "redis": "^6.3.1"
  }
}
