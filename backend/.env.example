# Copy to backend/.env (gitignored) and choose your own local password.
EVENTHUB_PG_PASSWORD=change-me-local-only
DATABASE_URL=postgres://eventhub:change-me-local-only@127.0.0.1:56432/eventhub_dev
# The database name MUST end in _test; the test suite refuses anything else.
TEST_DATABASE_URL=postgres://eventhub:change-me-local-only@127.0.0.1:56432/eventhub_test
# Lecture 13 (optional): without REDIS_URL the app runs with no cache at all.
REDIS_URL=redis://127.0.0.1:56379
CACHE_TTL_SECONDS=60
# Lecture 17: feature flag, exactly true or false (default true). false = no cache, REDIS_URL is not read.
CACHE_ENABLED=true
# Tests use their own variable so they never touch the dev cache; unset = no cache in tests.
# Only keys under event:public:v1: are ever deleted by the test helpers.
TEST_REDIS_URL=redis://127.0.0.1:56379
# Lecture 14: the job queue uses its OWN Redis (durable, noeviction), never the cache above.
# Without QUEUE_REDIS_URL the queue scripts refuse to start; queue tests are skipped.
QUEUE_REDIS_URL=redis://127.0.0.1:56380
TEST_QUEUE_REDIS_URL=redis://127.0.0.1:56380

# Lecture 17: other settings, all optional. A variable that is SET must be valid (an empty value is an error);
# leave it out entirely to get the default. Precedence: real environment > this file > default.
# APP_ENV=development            # development | test | production
# PORT=8080                      # 1-65535
# CORS_ORIGIN=http://localhost:3000
# LOG_REQUESTS=0                 # 0 or 1
# LOG_LEVEL=info                 # debug | info | warn | error (lecture 18)
# SEED_DEMO_USERS=0              # 0 or 1 (must be 0 when APP_ENV=production)
# QUEUE_NAME=eventhub-notifications
# QUEUE_PREFIX=
# WORKER_CONCURRENCY=            # whole numbers; WORKER_LOCK_MS / WORKER_STALLED_MS likewise
